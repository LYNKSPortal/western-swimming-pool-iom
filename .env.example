# Copy to .env.local and fill in real values. Never commit .env.local.

# Neon Postgres connection strings (populate with `neon link` / `neon env pull`)
DATABASE_URL="postgresql://user:password@host/neondb?sslmode=require"
DATABASE_URL_UNPOOLED="postgresql://user:password@host/neondb?sslmode=require"

# Staff admin dashboard (/admin) — single shared password for now.
ADMIN_PASSWORD="change-me"
# Random 32+ byte secret used to sign the admin session cookie. Generate with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET="change-me-too"
